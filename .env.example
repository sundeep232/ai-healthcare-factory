# AI
CLAUDE_API_KEY=sk-ant-api03-your-key-here
CLAUDE_MODEL=claude-sonnet-5-5
# Optional: cost estimate rates in USD per million tokens (defaults: 3.00 / 15.00)
# CLAUDE_INPUT_COST_PER_MTOK=3.00
# CLAUDE_OUTPUT_COST_PER_MTOK=15.00

# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2
# Default region for demo instances (PostgreSQL Flexible Server can be restricted per region/subscription)
DEMO_LOCATION=centralus

# Shared Resources (filled after bootstrap)
TFSTATE_STORAGE_ACCOUNT=
TFSTATE_CONTAINER=tfstate
TFSTATE_RESOURCE_GROUP=rg-factory-shared
KEY_VAULT_NAME=
ACR_LOGIN_SERVER=
COSMOS_ENDPOINT=

# App
ENVIRONMENT=development
LOG_LEVEL=INFO
