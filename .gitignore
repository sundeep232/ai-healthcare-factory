# Secrets (NEVER commit)
.env
.env.*
!.env.example

# Python
venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfplan
*.tfvars
!*.tfvars.example
crash.log

# Per-instance generated Terraform (keep .gitkeep)
terraform/instances/*/
!terraform/instances/.gitkeep

# Node / UI
node_modules/
dist/
.vite/
coverage/

# Logs & OS
*.log
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp

# Terraform plugin cache and module lock files (generated by local validation)
.terraform-cache/
terraform/modules/**/.terraform.lock.hcl

# Local demo records written by the API
.factory-data/
