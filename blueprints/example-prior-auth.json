{
  "blueprint_id": "22222222-2222-4222-8222-222222222222",
  "version": 1,
  "parent_version": null,
  "created_at": "2026-10-24T00:00:00Z",
  "instance_slug": "prior-auth",
  "summary": "Prior-authorization and care management demo: Postgres for members, providers, and authorizations; Cosmos DB for care plans; blob storage for clinical attachments.",
  "requirements": {
    "demo_name": "Prior Authorization and Care Management",
    "summary": "Demonstrate how prior-auth requests are reviewed and how care managers follow up with high-risk members.",
    "target_audience": "Utilization management and care management teams",
    "business_goals": [
      "Show prior-auth turnaround and approval rates",
      "Show care manager outreach to high-risk members"
    ],
    "domains": ["authorization", "care_management", "member", "provider"],
    "data_scale": { "member_count": 2000, "history_months": 12 },
    "experience": { "web_ui": true, "api": true, "analytics_dashboard": false },
    "azure_region": "centralus",
    "ttl_days": 14,
    "synthetic_data_only": true,
    "assumptions": ["Defaulted to 12 months of history."],
    "open_questions": []
  },
  "resources": [
    { "id": "rg", "type": "resource_group", "name": "prior-auth-rg", "purpose": "Holds every resource in this demo", "sku": null, "config": {}, "depends_on": [] },
    { "id": "logs", "type": "log_analytics", "name": "prior-auth-logs", "purpose": "Central logging for the API", "sku": "PerGB2018", "config": { "retention_in_days": 30 }, "depends_on": ["rg"] },
    { "id": "db", "type": "postgresql_flexible", "name": "prior-auth-db", "purpose": "Stores members, providers, and authorizations", "sku": "B_Standard_B1ms", "config": { "storage_mb": 32768, "version": "16" }, "depends_on": ["rg"] },
    { "id": "docs", "type": "cosmos_db", "name": "prior-auth-care", "purpose": "Stores care plans and care-team timelines", "sku": "serverless", "config": { "database_name": "care", "containers": ["care_plans", "outreach"] }, "depends_on": ["rg"] },
    { "id": "files", "type": "storage_account", "name": "priorauthfiles", "purpose": "Holds synthetic clinical attachments", "sku": "Standard_LRS", "config": { "containers": ["attachments"] }, "depends_on": ["rg"] },
    { "id": "kv", "type": "key_vault", "name": "prior-auth-kv", "purpose": "Holds database credentials", "sku": "standard", "config": {}, "depends_on": ["rg"] },
    { "id": "api", "type": "container_app", "name": "prior-auth-api", "purpose": "Serves authorization and care data", "sku": "Consumption", "config": { "cpu": 0.5, "memory": "1Gi", "min_replicas": 0, "max_replicas": 2 }, "depends_on": ["rg", "logs", "db", "docs", "kv"] },
    { "id": "web", "type": "static_web_app", "name": "prior-auth-web", "purpose": "Hosts the demo UI", "sku": "Free", "config": {}, "depends_on": ["rg"] }
  ],
  "data_plan": [
    { "domain": "member", "target_resource_id": "db", "record_count": 2000 },
    { "domain": "provider", "target_resource_id": "db", "record_count": 80 },
    { "domain": "authorization", "target_resource_id": "db", "record_count": 3000 },
    { "domain": "care_management", "target_resource_id": "docs", "record_count": 300 }
  ]
}
