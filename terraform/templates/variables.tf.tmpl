variable "subscription_id" {
  description = "Azure subscription to deploy into."
  type        = string
}

variable "location" {
  description = "Azure region for every resource."
  type        = string
  default     = "{{LOCATION}}"
}

variable "instance_slug" {
  description = "Short slug used to name resources."
  type        = string
  default     = "{{SLUG}}"
}

variable "tags" {
  description = "Extra tags merged into local.tags."
  type        = map(string)
  default     = {}
}
